{
  "name": "open-web-runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false",
    "test": "tsx --test packages/*/test/*.test.ts",
    "dev": "npm run build && node --env-file-if-exists=.env apps/api/dist/server.js",
    "start": "node --env-file-if-exists=.env apps/api/dist/server.js",
    "mcp": "node apps/api/dist/stdio.js",
    "mcp:config": "node scripts/configure-client.mjs",
    "test:e2e": "node scripts/e2e-smoke.mjs",
    "test:mcp": "node scripts/mcp-no-key-smoke.mjs",
    "test:video": "node scripts/video-smoke.mjs",
    "test:media": "node scripts/mcp-media-smoke.mjs",
    "test:public-video": "node scripts/public-video-probe.mjs",
    "accept:social-video": "node scripts/accept-shared-video.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "playwright": "^1.55.0",
    "@modelcontextprotocol/client": "2.1.0"
  }
}
