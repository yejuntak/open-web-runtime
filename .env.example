# Intended default: private, single-operator MCP. No model key required.
HOST=127.0.0.1
PORT=8787
MCP_ONLY=true
HEADLESS=true
ALLOW_PRIVATE_NETWORKS=false
REQUIRE_CONFIRMATION_FOR_HIGH_RISK=true
MAX_BROWSER_SESSIONS=4
BROWSER_SESSION_TTL_MS=300000
CAPTURE_SCREENSHOTS=false
LIVE_FRAMES=false
OWR_API_TOKEN=
OWR_API_URL=http://localhost:8787
CHROME_EXECUTABLE_PATH=
REMOTE_CDP_URL=
SEARXNG_BASE_URL=
# Optional standalone Agent: set MCP_ONLY=false and configure a model provider.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=
LLM_API_MODE=responses
MAX_AGENT_STEPS=20
MAX_CONSECUTIVE_ACTION_FAILURES=3
